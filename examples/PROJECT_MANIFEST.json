{
  "schema": "gep.project.v1",
  "project": "example-vla",
  "desired_outcome": "Demonstrate verified VLA evaluation skills",
  "goal_domains": ["career", "learning"],
  "go_no_go_reason": "Demonstrates target-role capabilities within a capped GPU budget",
  "acceptance": [
    {"name": "baseline evaluation", "evidence": "artifacts/baseline_metrics.json"},
    {"name": "simulation recording", "evidence": "artifacts/simulation.mp4"},
    {"name": "final report", "evidence": "artifacts/report.md"}
  ],
  "resources": {
    "code": {"provider": "github", "locator": "OWNER/REPO"},
    "frontend": {"provider": "vercel", "locator": "project-id-if-any"},
    "backend": {"provider": "external", "locator": "backend-host-if-any"},
    "gpu": {"provider": "on-demand", "locator": "provider-neutral", "persistent": false},
    "artifacts": {"provider": "object-storage", "locator": "user-managed-bucket", "persistent": true}
  },
  "constraints": {"requires_approval_for_spend": true, "max_active_projects": 2}
}
